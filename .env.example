# Social Content App — Environment Variables
# Copy this to .env.local and fill in your values

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI (for image generation — coming soon)
OPENAI_API_KEY=***

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth redirects (email confirmation)
# Add this URL to your Supabase Auth settings → Redirect URLs
# For local development:
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
